# Discord Bot Configuration
# Copy this file to .env and fill in the values

# Your Discord bot token (from the Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here

# The ID of the voice channel to watch for user entry
DISCORD_VOICE_CHANNEL_ID=your_voice_channel_id_here

# The ID of the text channel to watch for user messages
TEXT_CHANNEL_ID=your_text_channel_id_here

# --- Tower (remote server) configuration (all required) ---

# The tower's fixed LAN IP or hostname
TOWER_HOST=192.168.1.100

# The tower's MAC address (for Wake-on-LAN)
WOL_MAC_ADDRESS=AA:BB:CC:DD:EE:FF

# The SSH user on the tower
TOWER_SSH_USER=pi

# Path to the Pi's private SSH key (optional, defaults to ~/.ssh/id_ed25519)
TOWER_SSH_KEY=~/.ssh/id_ed25519
