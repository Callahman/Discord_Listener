# Server Listener Configuration
# Copy this file to .env and fill in the values

# --- Discord Configuration ---

# Your Discord bot token (from the Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here

# The ID of the Discord channel where LLM responses will be pushed
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# The ID of the voice channel the tower bot joins to record audio
DISCORD_VOICE_CHANNEL_ID=your_voice_channel_id_here

# The ID of the text channel the tower bot reads user messages from
TEXT_CHANNEL_ID=your_text_channel_id_here

# --- Voice Bot Configuration ---

# The directory where the voice bot writes WAV files (local to the tower)
RECORDINGS_DIR=~/discord_listener/Server_Listener/recordings

# --- Whisper Configuration ---

# The size of the Whisper model to use (tiny, base, small, medium, large)
WHISPER_MODEL_SIZE=base

# --- Ollama Configuration ---

# Base URL of the Ollama instance (no trailing /v1 — the code appends it)
OLLAMA_BASE_URL=http://localhost:11434

# The model tag exactly as shown by `ollama list`
OLLAMA_MODEL=qwen3.5:latest

# The system prompt sent to the LLM (configurable)
LLM_SYSTEM_PROMPT=You are a helpful assistant. Summarize and analyze the provided transcription.

# --- Retry Configuration ---

# Maximum number of retries before a file is moved to the failed directory
MAX_RETRIES=3

# --- Directory Configuration ---

# The directory where incoming WAV files are placed (from the voice bot)
INCOMING_DIR=~/discord_listener/Server_Listener/recordings

# The directory where files that failed after MAX_RETRIES are moved to
FAILED_DIR=~/discord_listener/failed

# The directory where the JSONL activity log is written
LOG_DIR=~/discord_listener/logs

# --- Audio Archive Configuration ---

# Directory where a copy of each processed WAV is archived
AUDIO_ARCHIVE_DIR=~/discord_listener/Server_Listener/archive

# Maximum size (in GB) to retain in the archive. Older files are deleted
# to make room when this limit is exceeded.
AUDIO_RETENTION_GB=5
